# Node environment (development, production, test)
NODE_ENV=development

# Server port
PORT=3000

# PostgreSQL database connection string
DATABASE_URL=postgresql://localhost:5432/um_squared

# JWT secrets for access and refresh tokens
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too

# JWT token expiration times
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CAS (Central Authentication Service) configuration
CAS_BASE_URL=https://cas.umass.edu/cas
CAS_SERVICE_URL=http://localhost:3000

# Directory for file uploads
UPLOAD_DIR=./static/uploads

# Frontend application URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173
